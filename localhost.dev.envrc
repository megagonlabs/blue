##### installation
# directories
export BLUE_DATA_DIR=/efs/blue_data/
export BLUE_INSTALL_DIR=~/rit-git/blue

#### build 
# specs
export BLUE_BUILD_LIB_SERVER=mypypi
export BLUE_BUILD_LIB_ARG="--extra-index-url  http://$(hostname -i):8888/simple/ --trusted-host $(hostname -i)"
export BLUE_BUILD_CACHE_ARG="--no-cache"
export BLUE_BUILD_IMG_SUFFIX="-private"
export BLUE_BUILD_PUBLISH=
export BLUE_BUILD_PLATFORM=linux/amd64
# docker
export BLUE_CORE_DOCKER_ORG=megagonlabs
export BLUE_DEV_DOCKER_ORG=megagonlabs

##### deployment
# servers
export BLUE_PRIVATE_API_SERVER_PORT=5050
export BLUE_PRIVATE_DB_SERVER_PORT=6379
export BLUE_PRIVATE_RAY_SERVER_PORT=6380
export BLUE_PRIVATE_WEB_SERVER_PORT=3000
export BLUE_PUBLIC_API_SERVER="$(hostname -i)"
export BLUE_PUBLIC_API_SERVER_PORT=5050
export BLUE_PUBLIC_DB_SERVER="$(hostname -i)"
export BLUE_PUBLIC_DB_SERVER_PORT=6379
export BLUE_PUBLIC_RAY_SERVER="$(hostname -i)"
export BLUE_PUBLIC_RAY_SERVER_PORT=6380
export BLUE_PUBLIC_RAY_CLIENT_PORT_RANGE="10000-10010"
export BLUE_PUBLIC_WEB_SERVER="$(hostname -i)"
export BLUE_PUBLIC_WEB_SERVER_PORT=3000
# spec
export BLUE_DEPLOY_DEVELOPMENT=True
export BLUE_DEPLOY_SECURE=False
export DISABLE_AUTHENTICATION=False
export BLUE_DEPLOY_TARGET=localhost
export BLUE_DEPLOY_VERSION=latest
# platform, registries
export BLUE_DEPLOY_PLATFORM="$(whoami)"
export BLUE_AGENT_REGISTRY=default
export BLUE_AGENT_REGISTRY_MODEL=/blue_data/models/paraphrase-MiniLM-L6-v2
export BLUE_DATA_REGISTRY=default
export BLUE_DATA_REGISTRY_MODEL=/blue_data/models/paraphrase-MiniLM-L6-v2
export BLUE_MODEL_REGISTRY=default
export BLUE_MODEL_REGISTRY_MODEL=/blue_data/models/paraphrase-MiniLM-L6-v2
export BLUE_OPERATOR_REGISTRY=default
export BLUE_OPERATOR_REGISTRY_MODEL=/blue_data/models/paraphrase-MiniLM-L6-v2
export BLUE_TOOL_REGISTRY=default
export BLUE_TOOL_REGISTRY_MODEL=/blue_data/models/paraphrase-MiniLM-L6-v2
# services
export BLUE_SERVICE_OPENAI_URL=ws://blue_service_openai:8001
# access
export BLUE_RBAC_CONFIG_FOLDER=/blue_data/config/rbac
export BLUE_EMAIL_DOMAIN_WHITE_LIST=megagon.ai
export FIREBASE_SERVICE_CRED=
export FIREBASE_CLIENT_ID=blue-9d597
